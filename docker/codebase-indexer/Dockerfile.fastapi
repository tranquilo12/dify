# Dockerfile.fastapi
FROM python:3.12-slim

WORKDIR /app

COPY codebase-indexer/requirements.txt .
RUN apt-get update && apt-get install -y git
RUN pip install --no-cache-dir -r requirements.txt

COPY codebase-indexer/*.py .

EXPOSE 7779

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "7779"]